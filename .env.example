NEXT_PUBLIC_CMS_URL=http://localhost:1337
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CMS_REVALIDATE_TIME=0
# Server-side only — NEVER prefix with NEXT_PUBLIC_
DOMAIN=http://localhost:3000
CMS_URL=http://localhost:1337
CMS_TOKEN=your-strapi-api-token

# On-demand revalidation
REVALIDATE_SECRET=your-strong-revalidate-secret

# Maintenance Mode
MAINTENANCE_MODE=false

# Optional Maintenance Customization
# MAINTENANCE_TITLE=Under Maintenance
# MAINTENANCE_MESSAGE="We're currently performing scheduled maintenance to improve our site. Please check back shortly."
# MAINTENANCE_ESTIMATED_END="Today at 18:00 UTC"
# MAINTENANCE_CONTACT_EMAIL=contact@example.com
# Secret key to bypass maintenance mode via ?bypass=<secret> query param or maintenance_bypass cookie
# MAINTENANCE_BYPASS_SECRET=your-bypass-secret
